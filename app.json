{
  "expo": {
    "name": "BlümSens",
    "slug": "blumsens",
    "version": "1.0.0",
    "scheme": "blumsens",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.blumsens.app"
    },
    "android": {
      "package": "com.blumsens.app",
      "adaptiveIcon": {
        "backgroundColor": "#48684A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#48684A"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "BlümSens usa la cámara para escanear hojas y el código QR de tus módulos.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BlümSens usa tus fotos para analizar hojas de tus plantas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
